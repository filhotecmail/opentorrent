# ============================================================
# OpenTorrent — .gitignore
# ============================================================

# --- Engenharia de prompt / agentes de IA (não versionar) ---
.opencode/
.specify/
.skill/
AGENTS.md
.claude/
.cursor/
.windsurf/
.codex/
.aider/

# --- Build do Rust ---
/target
**/*.rs.bk

# --- Dados da aplicação ---
/downloads
*.torrent

# --- Estado local do pipeline de US (US-017) ---
.us-pipeline.state

# --- Firma digital (US-018) — nunca versionar ---
.signing/
*.sig

# --- Credenciais — nunca versionar ---
gemfury.secrets.yaml
.env
.env.*
!.env.example

# --- Dependências de JS/Node (tooling auxiliar) ---
node_modules/
package-lock.json
bun.lock
pnpm-lock.yaml
yarn.lock

# --- Logs ---
*.log

# --- Cobertura (cargo tarpaulin) e profiling ---
/coverage/
*.profraw
*.profdata

# --- Artefatos e temporários ---
*.tmp
*.bak
*.orig
*.old
*.swp
*.swo
*~

# --- Editores/IDEs ---
.vscode/
.idea/
*.iml

# --- Sistema operacional ---
.DS_Store
Thumbs.db
.desktop.ini